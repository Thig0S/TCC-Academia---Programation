{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "vendas-em-aberto": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/configuracoes/provedores-fonte-vendas.ts",
                  "with": "src/configuracoes/provedores-fonte-vendas.local.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "build-paginacao-fixture": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/paginacao-fixture",
            "index": "src/testing/paginacao-fixture-index.html",
            "browser": "src/testing/paginacao-fixture-main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "vendas-em-aberto:build:production"
            },
            "development": {
              "buildTarget": "vendas-em-aberto:build:development"
            },
            "local": {
              "buildTarget": "vendas-em-aberto:build:development",
              "host": "127.0.0.1",
              "port": 4200,
              "proxyConfig": "proxy-local.cjs"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-paginacao-fixture": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "vendas-em-aberto:build-paginacao-fixture",
            "host": "127.0.0.1",
            "port": 4301
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
